{
  "name": "oitucards",
  "main": "../worker/index.mjs",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SYNC_USERS", "class_name": "OituSyncUserPortable" }
    ]
  },
  "exports": {
    "OituSyncUser": { "type": "durable-object", "storage": "sqlite" },
    "OituSyncUserSQLite": { "type": "durable-object", "storage": "sqlite" },
    "OituSyncUserPortable": { "type": "durable-object", "storage": "sqlite" }
  }
}
